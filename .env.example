# Turso database (content: hero slides, articles, gallery, news)
TURSO_DATABASE_URL=libsql://your-db-name-yourorg.aws-ap-northeast-1.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Admin auth
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-too

# Netlify Blobs (media storage) needs no manual keys when deployed on Netlify —
# it authenticates automatically via the Netlify build/runtime context.
# For local dev with `netlify dev`, this also works automatically once the
# site is linked with `netlify link`.
